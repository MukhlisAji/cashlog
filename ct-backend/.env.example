PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Production (VPS behind Nginx/Caddy)
# NODE_ENV=production
# CORS_ORIGIN=https://cashlog.id
# FRONTEND_URL=https://cashlog.id
# GOOGLE_REDIRECT_URI=https://api.cashlog.id/api/sheets/oauth/callback
TRUST_PROXY=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Supabase (auth verification + profile updates)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth / Sheets — OAUTH_STATE_SECRET wajib ≥32 karakter di production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/sheets/oauth/callback
OAUTH_STATE_SECRET=

# Meta WhatsApp Cloud API
# Callback URL di Meta: https://<api-host>/meta/webhook  (atau /api/meta/webhook)
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
# App Secret (Meta Developer > App settings) — HMAC X-Hub-Signature-256
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_API_VERSION=v22.0
META_WEBHOOK_PATH=webhook
META_WA_ONBOARDING_TEMPLATE=onboarding_notif_v1
META_WA_MEMBER_ONBOARDING_TEMPLATE=household_welcome_msg_v1
META_WA_DAILY_REMINDER_TEMPLATE=daily_reminder_v1
META_WA_ONBOARDING_TEMPLATE_LANG=id

PARSER_MODE=hybrid
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Midtrans Snap (sandbox: prefix SB- / MIDTRANS_IS_PRODUCTION=false)
# snap = satu kali bayar via halaman checkout Midtrans (QRIS, VA, kartu tes)
# recurring = simpan kartu/GoPay lalu auto-charge bulanan (butuh webhook publik)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CHECKOUT_MODE=snap
# true = klik bayar / tambah slot langsung aktif, tanpa Snap. Matikan setelah Midtrans approved.
SKIP_PAYMENTS=false

# Subscription pricing (IDR)
PRO_PRICE=49000
HOUSEHOLD_MEMBER_PRICE=5000
MAX_HOUSEHOLD_MEMBER_SLOTS=5
TRIAL_DAYS=7
SUBSCRIPTION_PERIOD_DAYS=30

# Dev test user (seed script) — kosongkan di production
TEST_USER_EMAIL=test@cashlog.id
TEST_USER_PASSWORD=test123456
TEST_USER_NAME=Test User

# Email (Resend — https://resend.com)
# RESEND_API_KEY=re_...
# EMAIL_FROM=cashlog.id <noreply@cashlog.id>
