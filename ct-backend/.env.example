PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Production (VPS behind Nginx/Caddy): set TRUST_PROXY=true agar rate limit pakai IP asli
# TRUST_PROXY=true
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=1 minute

# Supabase (auth verification + profile updates)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth / Sheets
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/sheets/oauth/callback
OAUTH_STATE_SECRET=

# Meta WhatsApp Cloud API
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v20.0

PARSER_MODE=hybrid
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Midtrans (Snap checkout + optional recurring subscription)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# snap = bayar per periode via Snap; recurring = auto-charge bulanan (kartu kredit / GoPay)
MIDTRANS_CHECKOUT_MODE=snap

# Subscription pricing (IDR) — satu paket
PRO_PRICE=49000
HOUSEHOLD_MEMBER_PRICE=5000
MAX_HOUSEHOLD_MEMBER_SLOTS=5
TRIAL_DAYS=7
SUBSCRIPTION_PERIOD_DAYS=30

# Dev test user (seed script + optional frontend login form)
TEST_USER_EMAIL=test@cashlog.id
TEST_USER_PASSWORD=test123456
TEST_USER_NAME=Test User

# Email notifications (Resend — https://resend.com)
# RESEND_API_KEY=re_...
# EMAIL_FROM=cashlog.id <noreply@cashlog.id>
