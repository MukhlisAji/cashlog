# UAT / Staging backend
# cp ct-backend/.env.uat.example ct-backend/.env

PORT=3001
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=https://staging.cashlog.id
FRONTEND_URL=https://staging.cashlog.id
TRUST_PROXY=true

SUPABASE_URL=https://your-uat-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-uat-service-role-key

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-staging.cashlog.id/api/sheets/oauth/callback
OAUTH_STATE_SECRET=change-me-long-random-string-min-32-chars

PARSER_MODE=hybrid
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Midtrans sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CHECKOUT_MODE=snap

PRO_PRICE=49000
TRIAL_DAYS=7
SUBSCRIPTION_PERIOD_DAYS=30

# Email (Resend) — opsional
RESEND_API_KEY=re_...
EMAIL_FROM=cashlog.id <noreply@cashlog.id>

# Matikan test user di staging
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_NAME=
