# UAT / Staging backend
# cp ct-backend/.env.uat.example ct-backend/.env

PORT=3001
HOST=0.0.0.0
NODE_ENV=production
CORS_ORIGIN=https://staging.cashlog.id
FRONTEND_URL=https://staging.cashlog.id
TRUST_PROXY=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

SUPABASE_URL=https://your-uat-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-uat-service-role-key

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-staging.cashlog.id/api/sheets/oauth/callback
OAUTH_STATE_SECRET=change-me-long-random-string-min-32-chars

PARSER_MODE=hybrid
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_API_VERSION=v22.0
META_WEBHOOK_PATH=webhook
META_WA_ONBOARDING_TEMPLATE=onboarding_notif_v1
META_WA_ONBOARDING_TEMPLATE_LANG=id

MIDTRANS_SERVER_KEY=SB-Mid-server-...
MIDTRANS_CLIENT_KEY=SB-Mid-client-...
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_CHECKOUT_MODE=snap

PRO_PRICE=49000
HOUSEHOLD_MEMBER_PRICE=5000
MAX_HOUSEHOLD_MEMBER_SLOTS=5
TRIAL_DAYS=7
SUBSCRIPTION_PERIOD_DAYS=30

RESEND_API_KEY=re_...
EMAIL_FROM=cashlog.id <noreply@cashlog.id>

TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_NAME=
