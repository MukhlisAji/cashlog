# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App & API URLs — ganti per environment
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Demo mode — preview UI tanpa Supabase/backend
# NEXT_PUBLIC_DEMO_MODE=true

# Test login (email/password) — set true hanya di local dev
NEXT_PUBLIC_ENABLE_TEST_LOGIN=true

# Test user display (must match backend TEST_USER_* + seed script)
NEXT_PUBLIC_TEST_USER_EMAIL=test@cashlog.id
NEXT_PUBLIC_TEST_USER_PASSWORD=test123456
NEXT_PUBLIC_TEST_USER_NAME=Test User

# Subscription display pricing (IDR) — should match backend PRO_PRICE
NEXT_PUBLIC_PRO_PRICE=49000
NEXT_PUBLIC_HOUSEHOLD_MEMBER_PRICE=5000
NEXT_PUBLIC_MAX_HOUSEHOLD_MEMBER_SLOTS=5
NEXT_PUBLIC_TRIAL_DAYS=7

# Nomor bot WhatsApp (E.164 tanpa +) — harus sama dengan nomor Meta Cloud API
NEXT_PUBLIC_WHATSAPP_ADMIN_PHONE=6285121371428

# Support contact (optional override)
NEXT_PUBLIC_SUPPORT_EMAIL=support@cashlog.id
